# ==============================================================================
# MedSafe Twin — Polypharmacy Guardian for Elders
# Environment Configuration Template (Placeholders only)
# ==============================================================================
# IMPORTANT:
# 1. Do NOT store real API keys or secrets in version control.
# 2. Rename this file to .env for local development.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Base URL (for CORS)
CLIENT_URL=http://localhost:5173

# Google Gemini Multimodal Vision API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Supported Gemini Flash model (e.g. gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Future Evidence Grounding Providers (Academic Prototype Placeholders)
# FDA_OPENAPI_KEY=your_fda_api_key_placeholder
# NCBI_PUBMED_API_KEY=your_ncbi_api_key_placeholder
